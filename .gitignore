# Python and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
*.egg-info/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*~

# Generated MadGraph builds are TRACKED, so the generated Fortran, Cards and
# process metadata can be diffed against another machine's build.  See
# REPRODUCTION_COMMANDS.md.
mg5/
# Compiled objects and archives stay ignored - they are rebuildable from the
# committed sources above, and differ by toolchain anyway.
*.so
*.o
*.a
*.mod

# Large/transient scientific artifacts
*.pt
*.pth
*.ckpt
*.lhe
*.lhe.gz
*.hepmc
*.root
*.npy
*.npz
*.log
param.log

# Result trees are TRACKED too, so a run can be compared against the curated
# tree directly.
# NOTE: *.pt checkpoints are still excluded by the "Large/transient scientific
# artifacts" block above.  Delete that *.pt line if the trained checkpoints
# should be tracked as well.
!results_public/

# Local build products
.deck_build/
.codex-finalizer/
build/
dist/

# Notebook autosaves
.ipynb_checkpoints/
**/.ipynb_checkpoints/
